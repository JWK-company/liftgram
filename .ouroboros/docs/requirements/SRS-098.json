              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "도출 URS: URS-032 · 근거: 수익 모델 보고서 2026-11-03 · 결정 ADR-046"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}