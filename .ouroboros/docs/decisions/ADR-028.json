  "id": "ADR-028",
  "type": "ADR",
  "title": "코칭 주체 = 사람(P2P) — 알고리즘 자동 처방 배제",
  "status": "Approved",
  "owner": "Product",
  "product": "health-practice",
  "created": "2026-07-26T06:05:00Z",
  "updated": "2026-07-26T06:05:00Z",
