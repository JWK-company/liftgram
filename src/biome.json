{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "includes": [
      "frontend/**",
      "contracts/src/**",
      "scripts/**",
      "*.ts",
      "*.mjs",
      "!**/*.css",
      "!**/gen",
      "!**/.next",
      "!**/test-results",
      "!**/playwright-report",
      "!**/blob-report"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  }
}
