<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">


        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- @plm SRS-095  앱 스킴 — 로그인(Custom Tabs)이 끝나면 liftgram://auth?code= 로 앱에 돌아온다 · 위젯 「운동 시작」은 liftgram://start -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="liftgram" android:host="auth" />
                <data android:scheme="liftgram" android:host="start" />
                <!-- 잠금 운동 화면 · 카드에서 잠금 해제 → 앱 운동 화면(SPEC-019 · REV-014 #26) -->
                <data android:scheme="liftgram" android:host="workout" />
            </intent-filter>

            <!-- 앱 링크 — liftgram.tarae.org 링크(피드 공유 등)를 이 앱이 연다 @plm SRS-095. 검증은 웹의 /.well-known/assetlinks.json
                 (ANDROID_CERT_SHA256 를 넣어야 응답한다). 보고서 10절. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- @plm SRS-095  공유 링크 경로만(qa code M-2) — 도메인 전체를 열면 /api 로그인 콜백까지 앱이 가로챈다 -->
                <data android:scheme="https" android:host="liftgram.tarae.org" />
                <data android:pathPrefix="/feed/" />
                <data android:pathPrefix="/u/" />
                <data android:pathPrefix="/hashtag/" />
                <!-- 그룹 챌린지 초대·상세(SPEC-064 · 앱 1.8.0) -->
                <data android:pathPrefix="/challenges/" />
            </intent-filter>

        </activity>

        <!-- 잠금화면 운동 카드(SPEC-017 Phase 4 · ADR-046) — 카드 버튼·휴식 끝 알람은 앱 안 리시버로만(exported=false) -->
        <receiver
            android:name=".lock.LockActionReceiver"
            android:exported="false" />

        <!-- 잠금화면 위 운동 화면(SPEC-019 · ADR-048) — 앱 안에서만 띄운다(exported=false · FSI·직접 시작) ·
             앱 작업과 섞이지 않게 taskAffinity 분리 · 최근 앱에 안 보임 · 세로 -->
        <activity
            android:name=".lock.LockWorkoutActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="org.tarae.liftgram.lockscreen"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density|fontScale"
            android:theme="@style/LockScreenTheme" />

        <!-- 정확 알람 권한이 없을 때 3분 미만 휴식의 끝 시각만 지키는 짧은 포그라운드 서비스(ADR-046: 카드는 포그라운드 서비스 없음 · 이것만 예외) -->
        <service
            android:name=".lock.RestShortService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!-- 운동 중에만 도는 포그라운드 서비스(SPEC-020 · ADR-049) — 프로세스가 얼지 않게 해 화면 꺼짐·켜짐 방송을 제때 받는다 ·
             알림은 운동 카드 그대로 · 휴식 끝 시각도 지킨다. 자체 배포 — 플레이 빌드에서는 specialUse 용도를 다시 판단 -->
        <service
            android:name=".lock.WorkoutService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="workout_lock_screen: keeps the workout session alive so the lock-screen workout screen appears when the screen turns off" />
        </service>

        <!-- 앱 설치 파일 업데이트(SPEC-018 §5 · ADR-047) — 세션 설치 결과(명시적 Intent 로만 · exported=false) · 업데이트 완료 알림 -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />
        <receiver
            android:name=".update.PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
        <!-- SPEC-018 · P2 보안 M-3  업데이트 APK 전용(cache/updates/ 만) -->
        <provider
            android:name=".update.UpdateFileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 그룹 챌린지 인증 사진(SPEC-064 · 앱 1.8.0) — 웹뷰 getUserMedia 를 Capacitor 가 이 권한으로 잇는다.
         카메라가 없는 기기도 설치되게 required=false(인증 화면이 「카메라 없음」을 안내한다). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- @plm SRS-095  주변 헬스장(웹뷰 geolocation) — Capacitor 가 웹뷰 위치 요청을 이 권한으로 잇는다(qa spec M-13) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 잠금화면 운동 카드(SPEC-017 §11) — 알림은 첫 운동 시작 때 묻는다 · 정확 알람은 안내(기본 거부) ·
         FOREGROUND_SERVICE 는 shortService 용(FOREGROUND_SERVICE_SHORT_SERVICE 라는 권한은 없다) · promoted 는 Android 16 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- 잠금화면 위 운동 화면(SPEC-019 · ADR-048) — 화면 꺼짐·휴식 끝에 띄운다. 자체 배포는 설치 때 허용 · 플레이 빌드에서는 다시 판단 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 운동 중 포그라운드 서비스(SPEC-020) · 「다른 앱 위에 표시」 — 앱이 뒤에 있어도 화면 꺼짐에 운동 화면을 직접 띄운다(특별 권한 · 프로필에서 설정을 연다) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 배터리 최적화 제외를 묻는 대화상자(SPEC-020 · 자체 배포 — 플레이 빌드에서는 다시 판단) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 앱 설치 파일 업데이트(SPEC-018) — 자체 배포 전용. **플레이 빌드에서는 빼야 한다**(플레이 정책 · ADR-047 결과) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
