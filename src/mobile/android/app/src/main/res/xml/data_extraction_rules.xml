<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 백업·기기 이전 — 잠금 카드 저장소(storeId·대기열)는 옮기지 않는다(SPEC-017 §6) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="liftgram_lock.xml" />
        <exclude domain="sharedpref" path="liftgram_lock_ui.xml" />
        <!-- SPEC-018(안드로이드 M-9) — 웹뷰 DB·쿠키(서버가 원본) · 업데이트 표식 -->
        <exclude domain="root" path="app_webview/" />
        <exclude domain="sharedpref" path="liftgram_update.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="liftgram_lock.xml" />
        <exclude domain="sharedpref" path="liftgram_lock_ui.xml" />
        <exclude domain="root" path="app_webview/" />
        <exclude domain="sharedpref" path="liftgram_update.xml" />
    </device-transfer>
</data-extraction-rules>
