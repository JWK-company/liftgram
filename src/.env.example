# ─────────────────────────────────────────────────────────────────────────────
# liftgram 웹 스택 환경변수  (원본 템플릿: tarae-web-stack)
#
# ⚠ 포트는 템플릿 기본값(3000/3001/5433/6380)에서 **의도적으로 옮겨 두었다**.
#   원본 tarae-web-stack이 같은 머신에서 그 포트로 돌고 있어 충돌하기 때문이다.
#   포트를 되돌리려면 그 인스턴스를 먼저 내려야 한다(프로세스를 죽이지 말 것 — CLAUDE.md §5).
#
# 이 파일이 설정의 **문서이자 원본**이다. `make env-init` 이 이 파일을 .env로 복사한다.
# .env는 커밋하지 않는다(.gitignore). 새 설정을 추가하면 반드시 여기에도 추가한다 —
# `make env-check` 가 src/env.mjs 스키마와 이 파일을 대조해 빠진 것을 잡아낸다.
#
# 규칙
#   · 값을 읽는 곳은 src/env.mjs 하나뿐이다(코드에서 process.env를 직접 읽지 않는다).
#   · [필수] 항목이 없으면 **부팅이 실패한다** — 조용히 뜨고 나중에 500이 나는 것보다 낫다.
#   · 로컬과 컨테이너가 같은 키를 쓴다. 값만 다르다(주석의 "컨테이너에서는" 참고).
# ─────────────────────────────────────────────────────────────────────────────

# ── 데이터베이스 ─────────────────────────────────────────────────────────────
# [필수] PostgreSQL 접속 문자열. 앱과 마이그레이션 러너가 함께 쓴다.
# 로컬: compose.dev.yaml이 5433으로 노출한다(기존 5432 설치와 충돌하지 않게).
# 컨테이너에서는 서비스 이름으로: postgres://app:app@db:5432/app
DATABASE_URL=postgres://app:app@localhost:5434/app

# ── 계정·인증 ──────────────────────────────────────────────────────────────────
# access 토큰(JWT) 서명 키. **32자 이상 필수** — 없으면 서버가 뜨지 않는다.
# 배포에서는 호스트가 생성한 랜덤 값을 쓴다(render.yaml의 generateValue).
# 이 값이 새면 누구나 토큰을 위조할 수 있으므로 저장소에 진짜 값을 넣지 않는다.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# ── 실시간 propagation ──────────────────────────────────────────────────────────────
# memory | redis   (기본 memory)
#   memory — 프로세스 안에서만 전파. 인스턴스가 하나면 충분하고 개발이 가볍다.
#   redis  — 인스턴스가 둘 이상일 때. 다른 프로세스의 구독자에게도 변경이 도달한다.
REALTIME_BUS=memory

# idempotency key 저장소. 지정하지 않으면 REALTIME_BUS를 따라간다.
# 인스턴스가 둘 이상이면 redis 여야 한다 — 메모리면 재시도가 다른 인스턴스로 가서 두 번 반영될 수 있다.
# IDEMPOTENCY_STORE=redis

# REALTIME_BUS=redis 일 때만 쓰인다.  (기본 redis://localhost:6379)
# 컨테이너에서는: redis://broker:6379
REDIS_URL=redis://localhost:6381

# ── rate limit ────────────────────────────────────────────────────────────────
# 창(RATE_LIMIT_WINDOW_SEC)당 허용 횟수. **0 이하면 비활성** — 로컬 개발에서 방해되면 0으로.
# 인스턴스가 둘 이상이면 저장소가 redis 여야 합산 한도가 유지된다(미지정 시 REALTIME_BUS를 따름).
RATE_LIMIT=120
RATE_LIMIT_WINDOW_SEC=60
# RATE_LIMIT_STORE=redis

# ── 서버 ─────────────────────────────────────────────────────────────────────
# 실행 단위가 둘이다(ADR-010): frontend(화면·프록시)와 backend(API 서버). 포트도 둘이다.
#
# frontend — 브라우저가 보는 유일한 주소. HTTP와 WebSocket이 같은 포트를 쓴다.  (템플릿 기본 3000)
PORT=3100

# backend — 내부 API 서버. **브라우저에 노출하지 않는다** — frontend가 프록시로 넘긴다.  (템플릿 기본 3001)
API_PORT=3101

# web이 api를 찾아가는 주소. 로컬은 루프백, 컨테이너에서는 서비스 이름.
#   로컬:      http://127.0.0.1:3101
#   컨테이너:  http://backend:3001   (compose가 덮어쓴다)
API_URL=http://127.0.0.1:3101

# 밖에서 보이는 주소. 절대 URL이 필요한 곳(메타데이터·인증 콜백·이메일 링크)이 이 값만 본다.
# 지금은 로컬 개발용. **도메인을 사면 여기만 바꾸면 된다** — 코드에는 도메인을 박지 않는다.
#   로컬:    http://localhost:3100
#   운영 예:  https://app.example.com
APP_URL=http://localhost:3100

# SIGTERM을 받고 이 시간 안에 못 끝내면 강제 종료한다.  (기본 10000 · 단위 ms)
# 오케스트레이터의 종료 유예(terminationGracePeriod 등)보다 **짧게** 잡을 것.
SHUTDOWN_TIMEOUT_MS=10000

# 화면 우측 타일에 표시되는 인스턴스 식별자.  (선택 · 기본은 호스트명)
# 여러 인스턴스를 띄워 propagation을 눈으로 확인할 때 구분용으로 쓴다.
# INSTANCE_ID=local-1

# ── 컨테이너 전용 (compose가 읽는다 · 앱 코드는 읽지 않는다) ─────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# 호스트에 노출할 포트. 이미 쓰는 포트가 있으면 여기만 바꾸면 된다.
DB_PORT=5434
BROKER_PORT=6381
WEB_PORT=3100

# compose 프로젝트 이름 — 지정하지 않으면 디렉터리 이름("src")이 쓰여 컨테이너·볼륨 이름이 모호해진다.
COMPOSE_PROJECT_NAME=liftgram

# 마이그레이션 SQL 위치. 컨테이너와 로컬의 실행 위치가 달라 조정이 필요할 때만 쓴다.
# (기본: 실행 위치를 보고 찾는다 — 컨테이너 /app/migrations · 로컬 ../database/migrations)
# MIGRATIONS_DIR=migrations

# api는 호스트에 노출하지 않는다(ADR-010 — 브라우저가 보는 것은 web뿐).
# 컨테이너 밖에서 직접 두드려 봐야 할 때만 잠깐 연다:
#   docker compose run --rm --publish 3001:3001 backend

# ── 사진 저장소 ───────────────────────────────────────────────────────────────
# disk(기본) = 서버 디스크. compose는 볼륨에 두지만, **무료 호스트의 디스크는 재배포에서 사라진다.**
# 사진을 오래 남기려면 s3로 바꾸고 아래 다섯 개를 채운다(Cloudflare R2 무료 10GB).
# 오타로 s3가 아닌 값을 넣으면 부팅이 멈춘다 — 조용히 disk로 떨어지면 사진이 사라지는 걸 모른다.
STORAGE_PROVIDER=disk
# MEDIA_DIR=              # 비우면 컨테이너 /app/media · 로컬은 ../.media
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_BUCKET=liftgram-media
# S3_REGION=auto          # R2는 auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── 착용장비 제휴(ADR-027) ────────────────────────────────────────────────────
# **기본은 꺼짐이다.** 켜지는 것은 값이 정확히 `true`일 때뿐 — 'yes'·'1'·'TRUE'는 전부 꺼짐이다.
# 미등록 매체에 광고를 노출하면 제재 대상이라, 오타로 켜지는 일이 없어야 한다.
#
# ⚠ 파트너스 매체 등록·최종 승인 전에는 **켜지 않는다.**
# 링크는 파트너스 공식 생성기로 **사람이 미리 만든 것만** 넣는다(서버는 조립하지 않는다).
# 8종 카테고리: wristWrap·strap·belt·kneeSleeve·gloves·shoes·chalk·armSleeve
GEAR_AFFILIATE_ENABLED=
# GEAR_AFFILIATE_LINKS={"belt":"https://link.coupang.com/a/…","strap":"https://link.coupang.com/a/…"}
GEAR_AFFILIATE_LINKS=

# ── 개발 피드백 → PLM 아이디어보드 (SRS-006) ──
# 내부 사람(coworker·admin)이 앱에서 적은 문제·개선을 PLM 아이디어보드에 등록한다.
# **토큰은 서버에만 둔다** — 앱 번들에 들어가면 회수할 방법이 없다.
# 비워 두면 그 탭만 "지금 안 된다"고 답한다(부팅은 막지 않는다).
PLM_API_URL=https://jwk-plm.shoi.ch
PLM_API_TOKEN=
PLM_PROJECT=liftgram
