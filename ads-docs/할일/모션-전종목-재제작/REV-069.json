                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_header"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "관점",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_header"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "운동역학 검토자",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "관절 순서·방향·무게중심이 실제 수행과 맞는가",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "자동 검사 검토자",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "marks": [
                          {
                            "type": "code"
                          }
                        ],
                        "text": "src/scripts/motion2/check.py",
                        "type": "text"
                      },
                      {
                        "text": " 가 틀린 자세를 놓치지 않는가, 완화가 남용되지 않는가",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "파이프라인 검토자",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "marks": [
                          {
                            "type": "code"
                          }
                        ],
                        "text": "src/scripts/motion2/run.py",
                        "type": "text"
                      },
                      {
                        "text": "·",
                        "type": "text"
                      },
                      {
                        "marks": [
                          {
                            "type": "code"
                          }
                        ],
                        "text": "src/scripts/motion2/render.py",
                        "type": "text"
                      },
                      {
                        "text": "·",
                        "type": "text"
                      },
                      {
                        "marks": [
                          {
                            "type": "code"
                          }
                        ],
                        "text": "src/scripts/motion2/comp.py",
                        "type": "text"
                      },
                      {
                        "text": "·",
                        "type": "text"
                      },
                      {
                        "marks": [
                          {
                            "type": "code"
                          }
                        ],
                        "text": "src/scripts/motion2/publish.py",
                        "type": "text"
                      },
                      {
                        "text": " 의 재현성·중단·지문",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "라이선스·공개 검토자",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "공개 저장소에 들어가도 되는 내용인가, 참고 자료 사용 규칙",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              }
            ],
            "type": "table_row"
          }
        ],
        "type": "table"
      },
      {
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "핵심 지적",
            "type": "text"
          }
        ],
        "type": "heading"
      },
      {
        "content": [
          {
            "content": [
              {
                "content": [
                  {
                    "text": "파워 클린 받는 순간 팔꿈치가 16cm 튀고 아래팔 비틀림이 223°까지 갔다. 손이 바를 축으로 반대 방향(뒤로)으로 돌게 짜여 있었다.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "type": "list_item"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "text": "크런치 손바닥이 뒤집혀 머리를 감싸지 않았다. 원암 로우는 당기는 동안 위팔이 125° 돌았다.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "type": "list_item"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "text": "레터럴 레이즈는 손목이 팔꿈치보다 높았고, 풀업은 무게중심이 바보다 뒤였으며, 푸시다운은 손 간격이 9.4cm 미끄러졌다.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "type": "list_item"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "marks": [
                      {
                        "type": "code"
                      }
                    ],
                    "text": "timing",
                    "type": "text"
                  },
                  {
                    "text": " 이 부드러운 계단을 두 번 겹쳐 최고 속도가 평균의 2.7배였다. Wan 이 몸을 지우는 원인 중 하나였다.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "type": "list_item"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "text": "검사는 아래팔 비틀림의 범위·프레임당 변화를 재지 않았고, 매달린 동작의 무게중심도 보지 않았다.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "type": "list_item"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "text": "공개 저장소에 내부 경로가 들어갈 수 있고, 일부 문서 문구에 내부 메시지 번호가 있다.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "type": "list_item"
          }
        ],
        "type": "bullet_list"
      },
      {
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "분류",
            "type": "text"
          }
        ],
        "type": "heading"
      },
      {
        "content": [
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "지적",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_header"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "분류",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_header"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "이유·반영",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_header"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "클린 손 회전 방향·팔꿈치 방향",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "채택",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "손가락 마디가 앞→위→뒤로 225° 돌게 바꾸고 팔꿈치 방향을 몸통 바깥으로 고정(",
                        "type": "text"
                      },
                      {
                        "marks": [
                          {
                            "type": "code"
                          }
                        ],
                        "text": "src/scripts/motion2/families/reps.py",
                        "type": "text"
                      },
                      {
                        "text": "). 받기 뒤 일어선 자세를 0.58~0.66 유지",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "크런치 손바닥",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "채택",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "엄지 방향을 뒤로, 손끝을 머리 뒤로",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "원암 로우 위팔 회전",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "채택",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "marks": [
                          {
                            "type": "code"
                          }
                        ],
                        "text": "jointed",
                        "type": "text"
                      },
                      {
                        "text": " 가 팔꿈치 방향(pole)을 받도록 바꾸고 아래팔은 ",
                        "type": "text"
                      },
                      {
                        "marks": [
                          {
                            "type": "code"
                          }
                        ],
                        "text": "sstep(0, 0.625, u)",
                        "type": "text"
                      },
                      {
                        "text": " 로 수직에 가깝게",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "레터럴·풀업·푸시다운",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "채택",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "손목 각을 팔꿈치와 같게, 풀업 몸 위치를 바 아래로·",
                        "type": "text"
                      },
                      {
                        "marks": [
                          {
                            "type": "code"
                          }
                        ],
                        "text": "support: hang",
                        "type": "text"
                      },
                      {
                        "text": ", 푸시다운 손 x 고정",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "시간 곡선 이중 적용",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "채택",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "marks": [
                          {
                            "type": "code"
                          }
                        ],
                        "text": "sstep(0.04, 0.96, t)",
                        "type": "text"
                      },
                      {
                        "text": " 한 번으로. 대표 16개 전부 재제작",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "아래팔 비틀림 범위·변화 검사",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "채택",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "marks": [
                          {
                            "type": "code"
                          }
                        ],
                        "text": "src/scripts/motion2/check.py",
                        "type": "text"
                      },
                      {
                        "text": " ",
                        "type": "text"
                      },
                      {
                        "marks": [
                          {
                            "type": "code"
                          }
                        ],
                        "text": "forearm_twist",
                        "type": "text"
                      },
                      {
                        "text": "(-105°~80°, 오른쪽은 부호 반전)·",
                        "type": "text"
                      },
                      {
                        "marks": [
                          {
                            "type": "code"
                          }
                        ],
                        "text": "twist_step",
                        "type": "text"
                      },
                      {
                        "text": " 25°. 덤벨 컬 뒤침이 실측 100°라 하한을 -105°로 잡음",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "매달린 무게중심 검사",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "채택",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "marks": [
                          {
                            "type": "code"
                          }
                        ],
                        "text": "support: hang",
                        "type": "text"
                      },
                      {
                        "text": " 이면 손 아래 12cm 안",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "두 허벅지 사이 각",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "채택",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "옆으로 걷기 동작 범위용 ",
                        "type": "text"
                      },
                      {
                        "marks": [
                          {
                            "type": "code"
                          }
                        ],
                        "text": "legs_open",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "클린 완화값 삭제",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "보류",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "빠른 동작이라 프레임당 관절각 38°·위치 14cm·비틀림 28°를 남김(상한 안). 근거는 이 문서에 둔다",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "클린 키를 뼈 길이 비율로",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "보류",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "모델이 하나뿐이라 지금은 효과가 없다. 체형을 바꿀 때 한다",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "무릎 목표각 입력·여유 비율",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "보류",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "선 자세 무릎 165~170° 는 사용자 컨펌 범위 안. 묶음 확장 때 원형별로 본다",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "PDEATHSIG·SIGTERM 즉시 종료, 키 오류와 환경 오류 분리",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
