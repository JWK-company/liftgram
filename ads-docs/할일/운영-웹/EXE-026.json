        "content": [
          {
            "content": [
              {
                "content": [
                  {
                    "text": "운영 값을 ",
                    "type": "text"
                  },
                  {
                    "marks": [
                      {
                        "type": "code"
                      }
                    ],
                    "text": "src/compose.prod.yaml",
                    "type": "text"
                  },
