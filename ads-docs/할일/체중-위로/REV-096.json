                  {
                    "marks": [
                      {
                        "type": "code"
                      }
                    ],
                    "text": "src/frontend/app/components/analytics/BodyweightCard.tsx",
                    "type": "text"
                  },
                  {
                    "text": " — 체중이 아닌 수치가 하나뿐일 때 체중 주간 변화 기준 문구가 나온다.",
                    "type": "text"
