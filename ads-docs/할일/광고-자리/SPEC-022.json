            "type": "text"
          },
          {
            "text": " 에 더한다. 기존 ",
            "type": "text"
          },
          {
            "marks": [
              {
                "type": "code"
              }
            ],
            "text": "activeLoaded",
            "type": "text"
          },
          {
            "text": " 의 뜻은 바꾸지 않는다.",
            "type": "text"
