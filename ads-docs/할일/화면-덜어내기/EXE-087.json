                  }
                ],
                "type": "paragraph"
              }
            ],
            "type": "list_item"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "text": "이번 운동의 앞선 세트와 비교하던 쿼리는 ",
                    "type": "text"
                  },
                  {
                    "marks": [
                      {
                        "type": "code"
                      }
                    ],
                    "text": "[원본·코드 리뷰 M1]",
                    "type": "text"
                  },
                  {
                    "text": "으로 막았다.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "type": "list_item"
          }
        ],
        "type": "bullet_list"
      },
      {
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "테스트 결과",
