                  },
                  {
                    "marks": [
                      {
                        "type": "code"
                      }
                    ],
                    "text": "${workoutId}:${exerciseId}",
                    "type": "text"
                  },
                  {
                    "text": "이다. 기다리기 전에 잡고, 축하하지 않았으면 푼다.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "type": "list_item"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "text": "기준은 ",
                    "type": "text"
                  },
                  {
                    "marks": [
                      {
                        "type": "code"
                      }
                    ],
                    "text": "historicalBestAllVariants",
                    "type": "text"
                  },
                  {
                    "text": "로 읽는다.",
                    "type": "text"
