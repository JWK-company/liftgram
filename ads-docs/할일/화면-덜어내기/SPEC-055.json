                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "type": "list_item"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "text": "시험: 위 화면을 다루는 ",
                    "type": "text"
                  },
                  {
                    "marks": [
                      {
