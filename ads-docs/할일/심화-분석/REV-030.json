                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "빈 칸 읽기, 숫자 줄 읽기 순서, 0% 표시",
