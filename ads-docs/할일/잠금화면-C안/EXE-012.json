                            "type": "code"
                          }
                        ],
                        "text": "-g \"SPEC-021\"",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "1 통과",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              }
            ],
            "type": "table_row"
          }
        ],
        "type": "table"
      },
      {
        "content": [
          {
            "content": [
              {
                "content": [
                  {
                    "text": "실패 1건은 보강한 시험의 식별자 오타(",
                    "type": "text"
                  },
                  {
                    "marks": [
                      {
                        "type": "code"
                      }
                    ],
                    "text": "row-theme",
                    "type": "text"
                  },
                  {
                    "text": ")였다. 고친 뒤 그 시험만 다시 돌렸고, 전체를 다시 돌리지는 않았다.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "type": "list_item"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "text": "건너뛴 2건은 결함 주입 빌드에서만 도는 시험이다.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "type": "list_item"
          }
        ],
        "type": "bullet_list"
      },
      {
        "content": [
          {
            "marks": [
              {
                "type": "strong"
              }
            ],
            "text": "에뮬레이터 확인(리뷰 반영 후, API 35):",
            "type": "text"
          }
        ],
        "type": "paragraph"
      },
      {
        "content": [
          {
            "content": [
              {
                "content": [
                  {
                    "text": "라이트·다크 화면이 맞게 나오고, 휴식 중과 운동 중의 ± 위치가 같다.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "type": "list_item"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "text": "± 를 끌어서 벗어나면 값이 그대로이고, 탭하면 82.5 로 바뀌며 강조색과 「kg · 원래 80」이 나온다.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "type": "list_item"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "text": "200ms 누름으로는 완료되지 않고, 1초 누름으로 완료되어 휴식 링이 시작된다. 대기열에 무게 82.5 가 들어간 완료 1건을 확인했다.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "type": "list_item"
          }
        ],
        "type": "bullet_list"
      },
      {
        "content": [
          {
            "marks": [
              {
                "type": "strong"
              }
            ],
            "text": "확인하지 못한 것:",
            "type": "text"
          }
        ],
        "type": "paragraph"
      },
      {
        "content": [
          {
            "content": [
              {
                "content": [
                  {
                    "text": "리뷰 반영 후 API 30 재확인과 뒤로 가기 재확인(반영 전에는 통과).",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "type": "list_item"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "text": "작은 화면·슈퍼셋·200% 글꼴 재확인. 작은 화면과 슈퍼셋은 반영 전에만 확인했다.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "type": "list_item"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "text": "API 24~26 실기기·에뮬레이터 확인. 자동 크기 수정은 코드로만 확인했다.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "type": "list_item"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "text": "꾹 누르는 중 단계 변경·완료 직후 PIN 창 수정의 직접 재현. 재현 시험이 없어 코드 수정과 일반 완료 동작만 확인했다.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
