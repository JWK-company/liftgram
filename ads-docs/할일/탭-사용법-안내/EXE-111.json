                          }
                        ],
                        "type": "paragraph"
                      }
                    ],
                    "type": "list_item"
                  },
                  {
                    "content": [
                      {
                        "content": [
                          {
                            "text": "슈퍼세트는 짧게 누르면 해냄이 아닌지(묶음 전체가 완료됨), 길게 누르면 이 종목만 완료되는지 본다.",
                            "type": "text"
                          }
                        ],
                        "type": "paragraph"
                      }
                    ],
                    "type": "list_item"
                  },
                  {
                    "content": [
                      {
                        "content": [
                          {
                            "text": "연습 중 ",
                            "type": "text"
                          },
                          {
                            "marks": [
                              {
                                "type": "code"
                              }
                            ],
                            "text": "/api/",
                            "type": "text"
                          },
                          {
                            "text": " 쓰기 요청이 0건이다.",
                            "type": "text"
                          }
