                    "text": "make verify",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "type": "list_item"
          }
        ],
        "type": "bullet_list"
      },
      {
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "text": "위험·주의",
            "type": "text"
          }
        ],
        "type": "heading"
      },
      {
        "content": [
          {
            "content": [
              {
                "content": [
                  {
                    "text": "글이 적은 지금은 추천 효과가 작다.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "type": "list_item"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "text": "SQL이 글 수에 비례해 느려질 수 있어 후보를 2000개로 자른다. 운영 규모에서 실행 계획을 확인한다.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "type": "list_item"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "text": "사용자별 종목 근거는 글에 실린 종목뿐이다. 기기 운동 기록은 쓰지 않는다.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "type": "list_item"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "marks": [
                      {
                        "type": "code"
                      }
                    ],
                    "text": "/discover",
                    "type": "text"
                  },
                  {
                    "text": " 입구가 줄어 사람 찾기는 돋보기로 간다. 돋보기에 사람 검색이 있다.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "type": "list_item"
          }
        ],
        "type": "bullet_list"
      }
