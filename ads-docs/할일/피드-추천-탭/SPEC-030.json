                      }
                    ],
                    "text": "src/frontend/e2e/feed-recommended.spec.ts",
                    "type": "text"
                  },
                  {
                    "text": " 와 가입·발견 탭을 쓰는 기존 e2e",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
