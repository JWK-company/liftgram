                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "오버·언더·뉴트럴·와이드·클로즈",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "숄더 프레스, 딥스, 어시스트 딥스",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "오버·뉴트럴·와이드·클로즈",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "트라이셉스 익스텐션",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "오버·언더·뉴트럴",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "슈러그, 풀오버, 오버헤드 트라이셉스, 레터럴 레이즈, 플라이, 인클라인 플라이, 리어 델트 플라이",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "오버·뉴트럴",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "어시스트 친업",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
