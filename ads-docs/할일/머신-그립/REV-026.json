        ],
        "type": "heading"
      },
      {
        "content": [
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "동작",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_header"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "그립",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_header"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "체스트·벤치·인클라인·디클라인 프레스, 시티드·하이·로우·체스트 서포티드 로우, 컬, 프리처 컬",
