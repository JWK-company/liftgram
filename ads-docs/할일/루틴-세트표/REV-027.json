                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "횟수 채우기 작업은 이미 구현됨(데이터 5, 제품)",
