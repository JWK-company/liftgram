                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "채택",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
