                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "웜업·드롭은 비우고, 작업 세트가 되면 나머지 줄의 목표를 따름",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "저장값이 그대로면 칸에 입력한 글자가 남음",
