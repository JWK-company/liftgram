                    "type": "paragraph"
                  }
                ],
                "type": "table_header"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "한쪽 입력에서 고정 무게가 절반으로 시작",
