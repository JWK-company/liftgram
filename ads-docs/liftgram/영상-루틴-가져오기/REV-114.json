            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "테스트·평가 검토자",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "패턴 표와 테스트의 대응 · 단언 세기 · 평가 스크립트의 편향과 합격선의 공정성(T1~T10)",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              }
            ],
            "type": "table_row"
          }
        ],
        "type": "table"
      },
