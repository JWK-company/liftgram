                            "type": "code"
                          }
                        ],
                        "text": "VerifiedGate",
                        "type": "text"
                      },
                      {
                        "text": " 는 문구가 글쓰기 전용이고 72시간 유예가 있어 그대로 쓸 수 없다 — 영상 RPC 전용 문이 필요하면 다음 판",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              }
            ],
            "type": "table_row"
          },
          {
            "content": [
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "S10",
                        "type": "text"
                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
