      {
        "attrs": {
          "language": "ts"
        },
        "content": [
          {
            "text": "type Prescribed = { exerciseId: string; sets: number; repsMin: number; repsMax: number; restSec?: number; from: 'video' | 'default' };\ninterface CreatorRoutine {\n  id: string;                 // 'cr-<topic>-<channel>'\n  topicId: CreatorTopicId;    // 'boulder-shoulders' | 'big3-500' | 'after-work'\n  source: { videoId: string; title: string; channel: string; channelUrl: string; verifiedAt: string /* YYYY-MM-DD */ };\n  summaryKo: string;          // 우리 말 요약 1~2문장(대본 인용 금지 · 웰니스 카피 게이트)\n  days: { nameKo: string; items: Prescribed[] }[];\n}\nCREATOR_TOPICS: { id, nameKo, nameEn, blurbKo, blurbEn }[]   // 3개\ncreatorRoutinesFor(topicId) · youtubeWatchUrl(videoId)",
            "type": "text"
          }
        ],
        "type": "code_block"
      },
