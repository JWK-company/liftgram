                      }
                    ],
                    "type": "paragraph"
                  }
                ],
                "type": "table_cell"
              },
              {
                "content": [
                  {
                    "content": [
                      {
                        "text": "운동 홈의 「영상·글로 루틴 가져오기」 링크 · 여러 날 저장 알림 useEffect",
                        "type": "text"
                      }
